#version 450

// SIGMOID, MUL by it and ADD, as one dispatch: d = c + a * sigmoid(g), with g one value or a's shape. The sigmoid is
// mul.comp's expression for a fused one; the product is rounded before the sum, as the two shaders store it.
// Offsets in floats.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (push_constant) uniform parameter
{
    uint ne;
    uint g_one;
    uint offs_a; uint offs_g; uint offs_c; uint offs_d;
} p;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer G {float data_g[];};
layout (binding = 2) readonly buffer C {float data_c[];};
layout (binding = 3) writeonly buffer D {float data_d[];};

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.ne) {
        return;
    }
    const float g = data_g[p.offs_g + (p.g_one != 0 ? 0 : i)];
    const float s = float(1. / (1 + exp(-1. * g)));
    precise const float m = data_a[p.offs_a + i] * s;
    data_d[p.offs_d + i] = data_c[p.offs_c + i] + m;
}
